rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to validate user profile fields on create/update
    function isValidUserProfile(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']);
    }

    // Explicitly deny client access to all internal sync metadata, cursors, and logs
    match /users/{userId}/_sync/{syncPath=**} {
      allow read, write: if false;
    }

    // User profile document: only the authenticated user can read or create/update their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(userId);
      allow update: if isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']);
      allow delete: if false;
    }

    // Deny all client access to business-data collections by default
    match /sales/{document=**} {
      allow read, write: if false;
    }
    match /payments/{document=**} {
      allow read, write: if false;
    }
    match /expenses/{document=**} {
      allow read, write: if false;
    }
    match /expense_payments/{document=**} {
      allow read, write: if false;
    }
    match /buyers/{document=**} {
      allow read, write: if false;
    }
    match /suppliers/{document=**} {
      allow read, write: if false;
    }
    match /production_cycles/{document=**} {
      allow read, write: if false;
    }
    match /harvests/{document=**} {
      allow read, write: if false;
    }
    match /audit_logs/{document=**} {
      allow read, write: if false;
    }

    // Fallback: Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
