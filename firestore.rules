rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // REUSABLE HELPER PRIMITIVES
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATION HELPERS
    // -------------------------------------------------------------------------
    
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    // -------------------------------------------------------------------------
    // COLLECTION MATCH BLOCKS
    // -------------------------------------------------------------------------

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile & Sync Data
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      
      // Sync subcollections
      match /_sync/{metaDoc} {
        // Only allow owner to read their own sync state for diagnostics/local hydration
        allow read: if isOwner(userId);
        // Write is typically mediated by Cloud Run (Admin SDK), but we allow owner for 
        // local-first direct sync if the app evolves that way.
        allow write: if isOwner(userId);
      }

      // Business Data subcollection
      match /business_data/{recordId} {
        // Owner has full read access to their business data
        allow read: if isOwner(userId);
        // Write is server-mediated (Admin SDK) to ensure monotonic versioning and change-logs
        // But we allow read for client-side list/get.
        allow write: if false; // Enforce server-side authoritative sync
      }
    }
  }
}
